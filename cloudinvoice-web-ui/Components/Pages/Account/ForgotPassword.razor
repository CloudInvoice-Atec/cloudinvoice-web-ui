@page "/account/forgot-password"
@layout Layout.PublicLayout
@using System.ComponentModel.DataAnnotations
@inject cloudinvoice_web_ui.Services.Identity.IAuthService AuthService

<h4 class="mt-0">Esqueceu a password</h4>
<p class="text-muted mb-4">Insira o seu endereço de email para receber um link de recuperação da password.</p>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success">
        <i class="mdi mdi-check-circle-outline me-2"></i> @_message
    </div>
    <div class="text-center d-grid mt-4">
        <a href="/" class="btn btn-primary">Voltar ao Login</a>
    </div>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="emailaddress" class="form-label">Endereço de email</label>
            <InputText id="emailaddress" class="form-control" type="email" placeholder="Introduza o seu email" @bind-Value="_model.Email" />
            <ValidationMessage For="@(() => _model.Email)" class="text-danger mt-1" />
        </div>

        <div class="text-center d-grid">
            <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>A enviar email</span>
                }
                else
                {
                    <span>Enviar email</span>
                }
            </button>
        </div>

        <div class="row mt-3">
            <div class="col-12 text-center">
                <p class="text-muted">Lembrou-se da password? <a href="/" class="text-muted ms-1"><b>Voltar ao Login</b></a></p>
            </div>
        </div>
    </EditForm>
}

@code {
    private ForgotModel _model = new();
    private bool _isSubmitting;
    private string _message;

    private async Task Submit()
    {
        _isSubmitting = true;
        await AuthService.ForgotPasswordAsync(_model.Email);
        _message = "Se existir uma conta com esse email, enviámos um link para redefinir a password.";
        _isSubmitting = false;
    }

    private class ForgotModel
    {
        [Required(ErrorMessage = "O email é obrigatório.")]
        [EmailAddress(ErrorMessage = "Formato de email inválido.")]
        public string Email { get; set; } = string.Empty;
    }
}