@page "/auth/set-password"
@using System.ComponentModel.DataAnnotations
@layout Layout.PublicLayout
@inject HttpClient Http
@inject NavigationManager Navigation

<h4 class="mt-0">Definir Nova Password</h4>
<p class="text-muted mb-4">Introduza e confirme a sua nova palavra-passe abaixo.</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isSuccess)
{
    <div class="alert alert-success rounded-3 py-3 text-center" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> Password guardada com sucesso!<br />
        <small class="text-muted">A redirecionar para o login...</small>
    </div>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="newpassword" class="form-label">Nova Password</label>
            <div class="input-group input-group-merge">
                <InputText type="password" autocomplete="new-password" @bind-Value="model.NewPassword" class="form-control" id="newpassword" placeholder="Introduza a nova password" />
                <div class="input-group-text" data-password="false">
                    <span class="password-eye"></span>
                </div>
            </div>
            <ValidationMessage For="@(() => model.NewPassword)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="confirmpassword" class="form-label">Confirmar Password</label>
            <div class="input-group input-group-merge">
                <InputText type="password" autocomplete="new-password" @bind-Value="model.ConfirmPassword" class="form-control" id="confirmpassword" placeholder="Confirme a nova password" />
                <div class="input-group-text" data-password="false">
                    <span class="password-eye"></span>
                </div>
            </div>
            <ValidationMessage For="@(() => model.ConfirmPassword)" class="text-danger" />
        </div>

        <div class="text-center d-grid mt-4">
            <button class="btn btn-primary" type="submit" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>A guardar...</span>
                }
                else
                {
                    <span>Guardar Password</span>
                }
            </button>
        </div>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ResetPasswordModel model = new();
    private string? errorMessage;
    private bool isSuccess = false;
    private bool isLoading = false;

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            errorMessage = "Link inválido ou parâmetros de segurança em falta.";
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "As passwords não coincidem.";
            return;
        }

        isLoading = true;

        try
        {
            var requestDto = new
            {
                Email = Email,
                Token = Token,
                NewPassword = model.NewPassword
            };

            var response = await Http.PostAsJsonAsync("https://localhost:5001/api/auth/reset-password", requestDto);

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                StateHasChanged();
                await Task.Delay(3000);
                Navigation.NavigateTo("/"); // Redireciona para a página de login raiz
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(errorContent)
                    ? $"Erro na API (Estado: {(int)response.StatusCode})"
                    : errorContent;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro de ligação: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ResetPasswordModel
    {
        [Required(ErrorMessage = "A nova password é obrigatória.")]
        [MinLength(6, ErrorMessage = "A password deve ter pelo menos 6 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "A confirmação da password é obrigatória.")]
        [Compare(nameof(NewPassword), ErrorMessage = "As passwords não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

}