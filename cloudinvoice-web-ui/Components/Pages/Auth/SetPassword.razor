@page "/auth/set-password"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="d-flex justify-content-center align-items-center w-100 h-100" style="min-height: 70vh;">
    <div class="w-100" style="max-width: 380px; padding: 1rem;">
        <h3 class="fw-bold text-center text-dark mb-4 fs-4">Set New Password</h3>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger rounded-3 py-2 text-center" role="alert" style="font-size: 0.9rem;">
                @errorMessage
            </div>
        }

        @if (isSuccess)
        {
            <div class="alert alert-success rounded-3 py-3 text-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> Password saved successfully!<br />
                <small class="text-muted">Redirecting to login...</small>
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">New Password</label>
                    <InputText type="password" autocomplete="new-password" class="form-control form-control-lg fs-6" @bind-Value="model.NewPassword" placeholder="Enter new password" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-semibold">Confirm New Password</label>
                    <InputText type="password" autocomplete="new-password" class="form-control form-control-lg fs-6" @bind-Value="model.ConfirmPassword" placeholder="Confirm password" />
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 py-2 rounded-3 shadow-sm" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Password</span>
                    }
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ResetPasswordModel model = new();
    private string? errorMessage;
    private bool isSuccess = false;
    private bool isLoading = false;

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            errorMessage = "Invalid link or missing security parameters.";
            return;
        }

        if (string.IsNullOrEmpty(model.NewPassword) || model.NewPassword.Length < 6)
        {
            errorMessage = "The password must be at least 6 characters long.";
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isLoading = true;

        try
        {
            var requestDto = new
            {
                Email = Email,
                Token = Token,
                NewPassword = model.NewPassword
            };

            var response = await Http.PostAsJsonAsync("https://localhost:5001/api/auth/reset-password", requestDto);

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                StateHasChanged();
                await Task.Delay(3000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                // Captura detalhada para sabermos exatamente o que a API respondeu
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(errorContent)
                    ? $"API Error (Status: {(int)response.StatusCode})"
                    : errorContent;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ResetPasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}