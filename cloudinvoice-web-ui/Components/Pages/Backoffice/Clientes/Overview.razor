@layout Layout.AdminLayout
@inject IJSRuntime JS
@page "/backoffice/clientes"
@using cloudinvoice_web_ui.Components.Modals
@using cloudinvoice_web_ui.DTOs.Clientes
@using cloudinvoice_web_ui.DTOs.Invoices
@inject cloudinvoice_web_ui.Services.Customers.ICustomerService CustomerService


<!-- Start Content-->
<div class="container-fluid">

    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <!-- Botão de Adicionar Cliente -->
                    <button data-bs-toggle="modal" data-bs-target="#modalNovoCliente" class="btn btn-blue waves-effect waves-light">
                        <i class="mdi mdi-plus-circle me-1"></i> Adicionar Cliente
                    </button>
                </div>
                <h4 class="page-title">Visão Geral de Clientes</h4>
            </div>
        </div>
    </div>
    <!-- end page title -->
    <!-- Cartões de Estatísticas -->
    <div class="row">
        <div class="col-md-6 col-xl-3">
            <div class="widget-rounded-circle card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="avatar-lg rounded-circle bg-soft-primary border-primary border">
                                <i class="fe-users font-22 avatar-title text-primary"></i>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-end">
                                <h3 class="text-dark mt-1"><span>@estatisticas.TotalClientes</span></h3>
                                <p class="text-muted mb-1 text-truncate">Total Clientes</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="widget-rounded-circle card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="avatar-lg rounded-circle bg-soft-success border-success border">
                                <i class="fe-user-check font-22 avatar-title text-success"></i>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-end">
                                <h3 class="text-dark mt-1"><span>@estatisticas.ClientesAtivos</span></h3>
                                <p class="text-muted mb-1 text-truncate">Ativos</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="widget-rounded-circle card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="avatar-lg rounded-circle bg-soft-info border-info border">
                                <i class="fe-user-plus font-22 avatar-title text-info"></i>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-end">
                                <h3 class="text-dark mt-1"><span>@estatisticas.NovosEsteMes</span></h3>
                                <p class="text-muted mb-1 text-truncate">Novos (Mês)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="widget-rounded-circle card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="avatar-lg rounded-circle bg-soft-warning border-warning border">
                                <i class="fe-alert-triangle font-22 avatar-title text-warning"></i>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-end">
                                <h3 class="text-dark mt-1">€<span>@estatisticas.TotalEmDivida</span></h3>
                                <p class="text-muted mb-1 text-truncate">Em Dívida</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end row-->
    <!-- Tabela de Listagem de Clientes -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="dropdown float-end">
                        <a href="#" class="dropdown-toggle arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-dots-vertical"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a href="javascript:void(0);" class="dropdown-item">Exportar Excel</a>
                            <a href="javascript:void(0);" class="dropdown-item">Imprimir Lista</a>
                        </div>
                    </div>

                    <h4 class="header-title mb-3">Listagem de Clientes</h4>

                    @if (_isLoading)
                    {
                        <div class="text-center my-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2">A carregar clientes...</p>
                        </div>
                    }
                    else if (!_clientes.Any())
                    {
                        <div class="alert alert-info text-center my-4">
                            Não existem clientes registados no sistema. Clique em "Adicionar Cliente" para começar.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table id="tabela-clientes" class="table table-borderless table-hover table-nowrap table-centered m-0">
                                <thead class="table-light">
                                    <tr>
                                        <th colspan="2">Cliente / Empresa</th>
                                        <th>NIF</th>
                                        <th>Email</th>
                                        <th>Estado</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cliente in _clientes)
                                    {
                                        <tr>
                                            <td style="width: 36px;">
                                                <div class="avatar-sm">
                                                    <span class="avatar-title bg-soft-secondary text-secondary rounded-circle">
                                                        @(!string.IsNullOrEmpty(cliente.Name) ? cliente.Name.Substring(0, 1).ToUpper() : "?")
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <h5 class="m-0 fw-normal">@cliente.Name</h5>
                                                <p class="mb-0 text-muted"><small>Tel: @cliente.Phone</small></p>
                                            </td>
                                            <td>@cliente.TaxId</td>
                                            <td>@cliente.Email</td>
                                            <td>
                                                @if (cliente.IsActive)
                                                {
                                                    <span class="badge bg-soft-success text-success">Ativo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-soft-danger text-danger">Inativo</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="/backoffice/clientes/@cliente.Id" class="btn btn-xs btn-light" title="Ver Perfil">
                                                    <i class="mdi mdi-eye"></i>
                                                </a>
                                                <a href="/backoffice/clientes/editar/@cliente.Id" class="btn btn-xs btn-light" title="Editar">
                                                    <i class="mdi mdi-pencil"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Aqui deves colocar a tua Componente Modal se a extraíste para um ficheiro à parte -->
<!-- <ModalNovoCliente /> -->
@code {
    // --- VARIÁVEIS DE ESTADO DA PÁGINA ---
    private List<CustomerProfileDto> _clientes = new List<CustomerProfileDto>();
    private OverviewClientesDto estatisticas = new OverviewClientesDto();

    private bool _isLoading = true;
    private bool _isDataTableInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        // 1. Simular as Estatísticas do Topo (até teres o endpoint da API feito)
        estatisticas = new OverviewClientesDto
        {
            TotalClientes = 124,
            ClientesAtivos = 118,
            NovosEsteMes = 12,
            TotalEmDivida = 3250.75
        };

        // 2. Chamar a API Real
        _clientes = await CustomerService.GetCustomersAsync();

        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 💡 MAGIA DE ARQUITETURA:
        // O DataTable (jQuery) só pode ser inicializado DEPOIS do Blazor ter desenhado a tabela no HTML.
        // Por isso, só inicializamos quando o Loading acaba e se houver clientes.
        if (!_isLoading && _clientes.Any() && !_isDataTableInitialized)
        {
            await JS.InvokeVoidAsync("iniciarMinhaDataTable", "#tabela-clientes");
            _isDataTableInitialized = true;
        }
    }
}