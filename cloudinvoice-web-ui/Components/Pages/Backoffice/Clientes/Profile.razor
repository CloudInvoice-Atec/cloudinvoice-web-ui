@page "/backoffice/clientes/{Id:guid}"
@page "/backoffice/clientes/perfil-teste"

@using cloudinvoice_web_ui.DTOs.Clientes
@using cloudinvoice_web_ui.DTOs.Invoices
@using cloudinvoice_web_ui.Services.Customers
@using cloudinvoice_web_ui.Services.Invoices 

@inject ICustomerService CustomerService
@inject IInvoiceService InvoiceService


<div class="container-fluid">

    <!-- Cabeçalho da Página -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="page-title mb-0 font-size-18">Perfil do Cliente</h4>
                
                <div class="page-title-right">
                    <a href="/backoffice/clientes" class="btn btn-secondary waves-effect waves-light me-1">
                        <i class="mdi mdi-arrow-left me-1"></i> Voltar à Lista
                    </a>
                    <a href="/backoffice/clientes/editar/@(customer?.Id)" class="btn btn-primary waves-effect waves-light">
                        <i class="mdi mdi-pencil me-1"></i> Editar Cliente
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (customer == null)
    {
        <!-- Estado de Carregamento -->
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">A carregar dados do cliente...</p>
        </div>
    }
    else
    {
        <div class="row mt-3">
            <!-- COLUNA ESQUERDA: Resumo Rápido e Contactos -->
            <div class="col-xl-4 col-lg-5">
                <div class="card text-center">
                    <div class="card-body">
                        <!-- Avatar -->
                        <div class="avatar-xl mx-auto mb-3">
                            <span class="avatar-title bg-soft-primary text-primary rounded-circle font-24">
                                @(string.IsNullOrEmpty(customer.Name) ? "?" : customer.Name.Substring(0, 1).ToUpper())
                            </span>
                        </div>

                        <h4 class="mb-0">@customer.Name</h4>
                        <p class="text-muted">NIF: @customer.TaxId</p>

                        <div class="mb-3">
                            @if (customer.IsActive)
                            {
                                <span class="badge bg-success font-13 p-1 px-2">Cliente Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger font-13 p-1 px-2">Cliente Inativo</span>
                            }
                        </div>
@* 
                        <div class="text-start mt-4 pt-2 border-top">
                            <h4 class="font-13 text-uppercase mb-3">Resumo Financeiro</h4>
                            <p class="text-muted mb-2 font-13"><strong>Em Dívida:</strong> <span class="ms-2 text-danger">@customer.CurrentDebt</span></p>
                            <p class="text-muted mb-2 font-13"><strong>Limite Crédito:</strong> <span class="ms-2">@customer.CreditLimit</span></p>
                            <p class="text-muted mb-2 font-13"><strong>Total Faturado:</strong> <span class="ms-2 text-success">@customer.TotalInvoiced</span></p>
                            <p class="text-muted mb-2 font-13"><strong>Condições Pag.:</strong> <span class="ms-2">@customer.PaymentTermsDays Dias</span></p>
                        </div> *@

                        <div class="text-start mt-4 pt-2 border-top">
                            <h4 class="font-13 text-uppercase mb-3">Contactos Gerais</h4>
                            <p class="text-muted mb-2 font-13"><strong>Email:</strong> <span class="ms-2">@customer.Email</span></p>
                            <p class="text-muted mb-2 font-13"><strong>Telefone:</strong> <span class="ms-2">@customer.Phone</span></p>
                            <p class="text-muted mb-2 font-13"><strong>Website:</strong> <span class="ms-2"><a href="@customer.Website" target="_blank">@customer.Website</a></span></p>
                        </div>

                        <div class="text-start mt-4 pt-2 border-top bg-light p-2 rounded">
                            <h4 class="font-13 text-uppercase mb-2 text-primary"><i class="mdi mdi-account-tie me-1"></i> Pessoa Responsável</h4>
                            <p class="text-muted mb-1 font-13"><strong>Nome:</strong> <span class="ms-2">@customer.ContactPersonName</span></p>
                            <p class="text-muted mb-1 font-13"><strong>Cargo:</strong> <span class="ms-2">@customer.ContactPersonRole</span></p>
                            <p class="text-muted mb-1 font-13"><strong>Email:</strong> <span class="ms-2"><a href="mailto:@customer.ContactPersonEmail">@customer.ContactPersonEmail</a></span></p>
                            <p class="text-muted mb-0 font-13"><strong>Tel:</strong> <span class="ms-2">@customer.ContactPersonPhone</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUNA DIREITA -->
            <div class="col-xl-8 col-lg-7">
                <div class="card">
                    <div class="card-body">
                        <!-- Menu das Tabs -->
                        <ul class="nav nav-pills nav-fill navtab-bg">
                            <li class="nav-item">
                                <a href="#detalhes" data-bs-toggle="tab" aria-expanded="true" class="nav-link active">
                                    Detalhes da Empresa
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#faturas" data-bs-toggle="tab" aria-expanded="false" class="nav-link">
                                    Histórico de Faturas
                                </a>
                            </li>
                        </ul>

                        <!-- Conteúdo das Tabs -->
                        <div class="tab-content mt-3">

                            <!-- TAB 1: Detalhes -->
                            <div class="tab-pane show active" id="detalhes">
                                <h5 class="mb-3 text-uppercase bg-light p-2"><i class="mdi mdi-office-building me-1"></i> Informação Geral</h5>
                                <div class="row mb-4">
                                    <div class="col-md-6 mb-2">
                                        <p class="text-muted mb-0">Nome Completo</p>
                                        <h6 class="font-14 mt-1">@customer.Name</h6>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <p class="text-muted mb-0">Nome Comercial (Marca)</p>
                                        <h6 class="font-14 mt-1">@(string.IsNullOrEmpty(customer.TradeName) ? "N/A" : customer.TradeName)</h6>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <p class="text-muted mb-0">NIF</p>
                                        <h6 class="font-14 mt-1">@customer.TaxId</h6>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <p class="text-muted mb-0">Cliente Desde</p>
                                        <h6 class="font-14 mt-1">@customer.CreatedAt.ToString("dd/MM/yyyy")</h6>
                                    </div>
                                </div>

                                <h5 class="mb-3 text-uppercase bg-light p-2"><i class="mdi mdi-map-marker me-1"></i> Morada e Localização</h5>
                                <div class="row mb-4">
                                    <div class="col-12 mb-2">
                                        <p class="text-muted mb-0">Endereço</p>
                                        <h6 class="font-14 mt-1">@customer.Address</h6>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <p class="text-muted mb-0">Código Postal</p>
                                        <h6 class="font-14 mt-1">@customer.PostalCode</h6>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <p class="text-muted mb-0">Cidade</p>
                                        <h6 class="font-14 mt-1">@customer.City</h6>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <p class="text-muted mb-0">País</p>
                                        <h6 class="font-14 mt-1">@customer.Country</h6>
                                    </div>
                                </div>

                                <h5 class="mb-3 text-uppercase bg-light p-2"><i class="mdi mdi-currency-eur me-1"></i> Dados Fiscais e Faturação</h5>
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <p class="text-muted mb-0">Desconto Padrão</p>
                                        <h6 class="font-14 mt-1">@customer.DefaultDiscount%</h6>
                                    </div>
                                </div>
                            </div>

                            <!-- TAB 2: Faturas -->
                            <div class="tab-pane" id="faturas">
                                <div class="table-responsive">
                                    <table class="table table-centered table-nowrap table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Fatura</th>
                                                <th>Emissão</th>
                                                <th>Vencimento</th>
                                                <th>Valor Total</th>
                                                <th>Estado</th>
                                                <th style="width: 100px;">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (customerInvoices != null && customerInvoices.Any())
                                            {
                                                foreach (var invoice in customerInvoices)
                                                {
                                                    <tr>
                                                        <td><strong>@invoice.InvoiceNumber</strong></td>
                                                        <td>@invoice.IssueDate.ToString("dd/MM/yyyy")</td>
                                                        <td>
                                                            @if (invoice.DueDate < DateTime.Now && invoice.Status != "Paid")
                                                            {
                                                                <span class="text-danger fw-bold">@invoice.DueDate.ToString("dd/MM/yyyy")</span>
                                                            }
                                                            else
                                                            {
                                                                @invoice.DueDate.ToString("dd/MM/yyyy")
                                                            }
                                                        </td>
                                                        <td>@invoice.TotalAmount.ToString("C")</td>
                                                        <td>
                                                            @if (invoice.Status == "Paid")
                                                            {
                                                                <span class="badge bg-success">Pago</span>
                                                            }
                                                            else if (invoice.Status == "Unpaid" && invoice.DueDate >= DateTime.Now)
                                                            {
                                                                <span class="badge bg-warning text-dark">Por Pagar</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-danger">Atrasado</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm btn-outline-primary" title="Ver Documento">
                                                                <i class="mdi mdi-eye"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-secondary" title="Descarregar PDF">
                                                                <i class="mdi mdi-download"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted py-4">
                                                        Não existem faturas registadas para este cliente.
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private CustomerProfileDto customer;
    private List<InvoiceSummaryDto> customerInvoices = new();

    protected override async Task OnInitializedAsync()
    {
        var customerId = Id ?? Guid.NewGuid();

        // 1. Obter Perfil do Cliente via CustomerService
        customer = await CustomerService.GetCustomerProfileAsync(customerId);

        // 2. Obter as últimas 5 Faturas via InvoiceService
        customerInvoices = await InvoiceService.GetRecentCustomerInvoicesAsync(customerId, count: 5);
    }
}