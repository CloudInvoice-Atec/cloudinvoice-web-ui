@page "/backoffice/faturas/detalhes/{Id:guid}"
@layout Layout.AdminLayout
@using cloudinvoice_web_ui.DTOs.Invoices
@using cloudinvoice_web_ui.Enums
@using cloudinvoice_web_ui.Services.Invoices
@using static cloudinvoice_web_ui.Enums.InvoiceEnums
@inject IInvoiceService InvoiceService
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container-fluid">
    <!-- Título e Botões Superiores -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="page-title">Detalhes da Fatura</h4>
                <div class="d-flex gap-2">
                    <button class="btn btn-light" @onclick="NavigateBack">
                        <i class="mdi mdi-arrow-left me-1"></i> Voltar
                    </button>

                    @if (_invoice != null)
                    {
                        @if (_invoice.Status == InvoiceStatus.Draft)
                        {
                            <button class="btn btn-primary" @onclick="EditarFatura">
                                <i class="mdi mdi-pencil me-1"></i> Editar
                            </button>
                            <button class="btn btn-danger" @onclick="AbrirModalEliminar">
                                <i class="mdi mdi-delete me-1"></i> Eliminar
                            </button>
                        }
                        else if (_invoice.Status == InvoiceStatus.Issued)
                        {
                            <button class="btn btn-warning" @onclick="AbrirModalCancelar">
                                <i class="mdi mdi-cancel me-1"></i> Cancelar Fatura
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">A carregar os detalhes do documento...</p>
        </div>
    }
    else if (_loadError || _invoice is null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="mdi mdi-block-helper me-2"></i> Não foi possível carregar a fatura. Verifique a ligação à base de dados.
        </div>
    }
    else
    {
        <!-- Informação Principal -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <!-- Cabeçalho do Documento e Status -->
                        <div class="row mb-4 border-bottom pb-3">
                            <div class="col-md-6">
                                <h3 class="mb-1 text-primary">Fatura Nº @(_invoice.InvoiceNumber ?? "RASCUNHO")</h3>
                                <p class="text-muted mb-0"><strong>Data de Emissão:</strong> @_invoice.IssueDate.ToString("dd/MM/yyyy")</p>

                                <p class="text-muted mb-0">
                                    <strong>Data de Vencimento:</strong> @_invoice.DueDate.ToString("dd/MM/yyyy")
                                    @if (FaturaEmAtraso())
                                    {
                                        <span class="badge bg-danger ms-2"><i class="mdi mdi-alert-circle-outline"></i> Em Atraso</span>
                                    }
                                </p>

                                @if (!string.IsNullOrEmpty(_invoice.Reference))
                                {
                                    <p class="text-muted mb-0 mt-1"><strong>Referência:</strong> @_invoice.Reference</p>
                                }
                            </div>
                            <div class="col-md-6 text-md-end mt-3 mt-md-0 d-flex flex-column align-items-md-end justify-content-center">
                                <div class="mb-2">
                                    <span class="badge @StatusBadgeClass(_invoice.Status) fs-5 me-2">@_invoice.Status</span>
                                    <span class="badge @PaymentBadgeClass(_invoice.PaymentStatus) fs-5">@_invoice.PaymentStatus</span>
                                </div>
                                @if (FaturaEmAtraso())
                                {
                                    <small class="text-danger fw-bold"><i class="mdi mdi-clock-alert-outline"></i> O prazo de pagamento já foi ultrapassado.</small>
                                }
                            </div>
                        </div>

                        <!-- Dados Apenas do Cliente -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="bg-light p-3 rounded border">
                                    <h6 class="text-uppercase text-muted mb-2">Faturado A</h6>
                                    <h5 class="mb-1 text-dark">@_invoice.CustomerName</h5>
                                    <p class="mb-1 text-muted"><abbr title="Número de Identificação Fiscal">NIF:</abbr> @_invoice.CustomerTaxNumber</p>
                                    <p class="mb-0 text-muted"><i class="mdi mdi-map-marker-outline"></i> @_invoice.CustomerAddress</p>
                                </div>
                            </div>
                        </div>

                        <!-- Tabela de Artigos -->
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-centered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produto/Serviço</th>
                                        <th class="text-center" style="width: 10%;">Qtd</th>
                                        <th class="text-end" style="width: 15%;">Preço Unit.</th>
                                        <th class="text-center" style="width: 10%;">Desc. (%)</th>
                                        <th class="text-center" style="width: 10%;">IVA (%)</th>
                                        <th class="text-end" style="width: 15%;">Total Liquido</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_invoice.Lines != null && _invoice.Lines.Any())
                                    {
                                        foreach (var linha in _invoice.Lines)
                                        {
                                            <tr>
                                                <td>@linha.Description</td>
                                                <td class="text-center">@linha.Quantity</td>
                                                <td class="text-end">@linha.UnitPrice.ToString("C2")</td>
                                                <td class="text-center">@linha.DiscountPercentage%</td>
                                                <td class="text-center">@linha.TaxRate%</td>
                                                <td class="text-end fw-bold">@CalcularTotalLinha(linha).ToString("C2")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-3">Sem artigos registados.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Totais e Notas -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="clearfix pt-3">
                                    <h6 class="text-muted">Notas adicionais:</h6>
                                    <small class="text-muted">
                                        @(string.IsNullOrEmpty(_invoice.Notes) ? "Nenhuma nota registada neste documento." : _invoice.Notes)
                                    </small>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="float-end mt-3 mt-sm-0">
                                    <table class="table table-borderless mb-0">
                                        <tbody>
                                            <tr>
                                                <td class="text-end"><strong>Subtotal Bruto:</strong></td>
                                                <td class="text-end">@CalcularSubtotalBruto().ToString("C2")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-end"><strong>Total Descontos:</strong></td>
                                                <td class="text-end text-danger">- @CalcularTotalDescontos().ToString("C2")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-end"><strong>Total IVA:</strong></td>
                                                <td class="text-end">@_invoice.TotalTax.ToString("C2")</td>
                                            </tr>
                                            <tr class="border-top">
                                                <td class="text-end fs-5"><strong>Total Fatura:</strong></td>
                                                <td class="text-end fs-5 text-primary fw-bold">@_invoice.TotalAmount.ToString("C2")</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Eliminar Rascunho -->
@if (_showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <!-- ... O CONTEÚDO DA MODAL ELIMINAR FICA IGUAL ... -->
        </div>
    </div>
}

<!-- Modal Cancelar Fatura Emitida -->
@if (_showCancelModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <!-- ... O CONTEÚDO DA MODAL CANCELAR FICA IGUAL ... -->
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private InvoiceResponseDto? _invoice;
    private bool _isLoading = true;
    private bool _loadError = false;
    private bool _isProcessing = false;

    // Controlo de Modais
    private bool _showDeleteModal = false;
    private bool _showCancelModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarFatura();
    }

    private async Task CarregarFatura()
    {
        _isLoading = true;
        _loadError = false;
        _invoice = await InvoiceService.GetInvoiceByIdAsync(Id);
        if (_invoice is null) _loadError = true;
        _isLoading = false;
    }

    // ====================================================================
    // LÓGICA FINANCEIRA E CÁLCULOS NO FRONT-END
    // ====================================================================

    private decimal CalcularTotalLinha(InvoiceLineResponseDto linha)
    {
        var bruto = linha.Quantity * linha.UnitPrice;
        var desconto = bruto * (linha.DiscountPercentage / 100m);
        var valorAposDesconto = bruto - desconto;
        var iva = valorAposDesconto * (linha.TaxRate / 100m);
        return valorAposDesconto + iva;
    }

    private decimal CalcularSubtotalBruto()
    {
        if (_invoice?.Lines == null) return 0;
        return _invoice.Lines.Sum(l => l.Quantity * l.UnitPrice);
    }

    private decimal CalcularTotalDescontos()
    {
        if (_invoice?.Lines == null) return 0;
        return _invoice.Lines.Sum(l => (l.Quantity * l.UnitPrice) * (l.DiscountPercentage / 100m));
    }

    private bool FaturaEmAtraso()
    {
        if (_invoice == null) return false;

        // Se está anulada ou já foi paga, não está em atraso
        if (_invoice.Status == InvoiceStatus.Canceled || _invoice.PaymentStatus == PaymentStatus.Paid)
            return false;

        // Verifica se hoje já passou da data de vencimento
        return _invoice.DueDate.Date < DateTime.Today;
    }

    // ====================================================================
    // NAVEGAÇÃO E CORES DOS ESTADOS
    // ====================================================================

    private void NavigateBack() => Navigation.NavigateTo("/backoffice/faturas");

    private void EditarFatura() => Navigation.NavigateTo($"/backoffice/faturas/editar/{Id}");

    private string StatusBadgeClass(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Draft => "bg-secondary",
        InvoiceStatus.Issued => "bg-success",
        InvoiceStatus.Canceled => "bg-danger",
        _ => "bg-light text-dark"
    };

    private string PaymentBadgeClass(PaymentStatus status) => status switch
    {
        PaymentStatus.Unpaid => "bg-danger",
        PaymentStatus.PartiallyPaid => "bg-warning text-dark",
        PaymentStatus.Paid => "bg-success",
        _ => "bg-light text-dark"
    };

    // --- (O resto da lógica das Modais de Eliminar e Cancelar mantêm-se iguais) ---
    private void AbrirModalEliminar() => _showDeleteModal = true;
    private void FecharModalEliminar() => _showDeleteModal = false;
    private async Task ConfirmarEliminar() { /* ... */ }

    private void AbrirModalCancelar() => _showCancelModal = true;
    private void FecharModalCancelar() => _showCancelModal = false;
    private async Task ConfirmarCancelar() { /* ... */ }
}