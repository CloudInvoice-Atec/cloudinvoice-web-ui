@page "/backoffice/faturas/nova"
@page "/backoffice/faturas/editar/{Id:guid}" 
@layout Layout.AdminLayout
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using cloudinvoice_web_ui.DTOs.Configuracoes
@using cloudinvoice_web_ui.Enums
@using static cloudinvoice_web_ui.Enums.InvoiceEnums
@inject cloudinvoice_web_ui.Services.Settings.ICompanyService CompanyService
@using cloudinvoice_web_ui.DTOs.Clientes
@inject cloudinvoice_web_ui.Services.Customers.ICustomerService CustomerService
@using cloudinvoice_web_ui.DTOs.Invoices
@inject cloudinvoice_web_ui.Services.Invoices.IInvoiceService InvoiceService

<!-- Start Content-->
<div class="container-fluid">
    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex justify-content-between align-items-center">
                <h4 class="page-title">@(Id.HasValue ? "Editar Fatura" : "Criar Nova Fatura")</h4>

                @if (Id.HasValue)
                {
                    <button class="btn btn-light" type="button" @onclick='() => Navigation.NavigateTo("/backoffice/faturas")'>
                        <i class="mdi mdi-arrow-left me-1"></i> Voltar
                    </button>
                }
            </div>
        </div>
    </div>
    <!-- end page title -->
    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">A preparar o ambiente de faturação...</p>
        </div>
    }
    else if (_loadError)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="mdi mdi-block-helper me-2"></i> Não foi possível carregar os dados necessários para emitir a fatura (ex: Dados da Empresa). Verifique a ligação.
        </div>
    }
    else
    {
        <!-- EditContext permite-nos ter dois botões (Rascunho e Emitir) controlando a validação manualmente -->
        <EditForm EditContext="@_editContext">
            <DataAnnotationsValidator />

            <!-- TOPO: Detalhes da Fatura, Emissor e Cliente -->
            <div class="row mb-3">

                <!-- 1. Emissor (A tua Empresa) -->
                <div class="col-lg-4 mb-3 mb-lg-0">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="text-uppercase bg-light p-2 mt-0 mb-3">Emitido Por</h5>

                            <div class="text-center mb-3">
                                @if (!string.IsNullOrEmpty(_empresa.Logo))
                                {
                                    <img src="@_empresa.Logo" alt="Logótipo" style="max-height: 80px;" />
                                }
                            </div>
                            <h4 class="text-uppercase mb-3 text-center text-primary">
                                @_empresa.Name
                            </h4>

                            <p class="text-muted mb-1">
                                <strong>NIF:</strong> @_empresa.TaxNumber
                            </p>
                            <p class="text-muted mb-1">
                                <strong>Morada:</strong> @_empresa.Address
                            </p>
                            <p class="text-muted mb-0">
                                <strong>Capital Social:</strong> @_empresa.ShareCapital?.ToString("C2")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- 2. Detalhes da Fatura -->
                <div class="col-lg-4 mb-3 mb-lg-0">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="text-uppercase bg-light p-2 mt-0 mb-3">Detalhes da Fatura</h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Número da Fatura</label>
                                    <input type="text" class="form-control" placeholder="Automático" disabled />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nº Referência</label>
                                    <InputText @bind-Value="novaFatura.Reference" class="form-control" placeholder="Opcional" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Data de Emissão <span class="text-danger">*</span></label>
                                    <InputDate @bind-Value="novaFatura.IssueDate" class="form-control" disabled />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label d-flex justify-content-between align-items-center">
                                        <span>Vencimento <span class="text-danger">*</span></span>
                                        @if (clienteSelecionado != null)
                                        {
                                            <span class="badge bg-soft-info text-info font-11">
                                                @(clienteSelecionado.PaymentTermsDays ?? 0) dias
                                            </span>
                                        }
                                    </label>
                                    <!-- Adicionado min para bloquear datas anteriores a hoje -->
                                    <InputDate @bind-Value="novaFatura.DueDate"
                                               class="form-control"
                                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>

                            <!-- Estado do Pagamento -->
                            <div class="mb-0">
                                <label class="form-label">Estado do Pagamento <span class="text-danger">*</span></label>
                                <InputSelect @bind-Value="novaFatura.PaymentStatus" class="form-select">
                                    <option value="@PaymentStatus.Unpaid">Por Pagar</option>
                                    <option value="@PaymentStatus.PartiallyPaid">Parcialmente Paga</option>
                                    <option value="@PaymentStatus.Paid">Paga (Liquidada)</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Cliente -->
                <div class="col-lg-4 mb-3 mb-lg-0">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="text-uppercase bg-light p-2 mt-0 mb-3">Faturado A (Cliente) <span class="text-danger">*</span></h5>

                            <div class="mb-3">
                                <InputSelect class="form-select" @bind-Value="novaFatura.CustomerId" @bind-Value:after="OnClienteSelecionadoAtualizado">
                                    <option value="">Selecione um cliente...</option>
                                    @if (_clientesAtivos != null)
                                    {
                                        @foreach (var cliente in _clientesAtivos)
                                        {
                                            <option value="@cliente.Id">@cliente.Name (NIF: @cliente.TaxId)</option>
                                        }
                                    }
                                </InputSelect>
                            </div>

                            @if (clienteSelecionado != null)
                            {
                                <div class="bg-light border rounded p-3 mt-3">
                                    <h5 class="mt-0 mb-2 text-dark">@clienteSelecionado.Name</h5>
                                    <p class="mb-1 text-muted"><strong>NIF:</strong> @clienteSelecionado.TaxId</p>
                                    <p class="mb-1 text-muted"><strong>Morada:</strong> @clienteSelecionado.Address</p>
                                    <p class="mb-1 text-muted">@clienteSelecionado.PostalCode - @clienteSelecionado.City</p>
                                    <p class="mb-0 text-muted">@clienteSelecionado.Country</p>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted mt-4">
                                    <i class="mdi mdi-account-search-outline" style="font-size: 3rem;"></i>
                                    <p class="mt-2">Selecione um cliente para ver os detalhes.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABELA DE PRODUTOS / LINHAS DA FATURA -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-uppercase bg-light p-2 mt-0 mb-3">Artigos & Detalhes</h5>

                            <div class="table-responsive">
                                <table class="table table-bordered table-centered mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 30%;">Produto/Serviço</th>
                                            <th style="width: 10%;">Qtd</th>
                                            <th style="width: 15%;">Preço Unit. (€)</th>
                                            <th style="width: 10%;">Desc. (%)</th>
                                            <th style="width: 15%;">IVA (%)</th>
                                            <th style="width: 15%;">Total Liquido (€)</th>
                                            <th style="width: 5%;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var linha in novaFatura.Items)
                                        {
                                            <tr>
                                                <td>
                                                    <InputSelect class="form-select" @bind-Value="linha.ProductId" @bind-Value:after="() => OnProdutoSelecionadoAtualizado(linha)">
                                                        <option value="">Selecione...</option>
                                                        @if (_produtosCatalogo != null)
                                                        {
                                                            @foreach (var prod in _produtosCatalogo)
                                                            {
                                                                <option value="@prod.Id">(@prod.Code) - @prod.Description</option>
                                                            }
                                                        }
                                                    </InputSelect>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control text-center" @bind="linha.Quantity" @bind:event="oninput" @onkeyup="CalcularTotais" min="1" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control text-end" @bind="linha.BasePrice" @bind:event="oninput" @onkeyup="CalcularTotais" step="0.01" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control text-center" @bind="linha.DiscountPercentage" @bind:event="oninput" @onkeyup="CalcularTotais" min="0" max="100" />
                                                </td>
                                                <td>
                                                    <select class="form-select" @bind="linha.TaxRate" @bind:after="CalcularTotais">
                                                        <option value="@(23m)">23%</option>
                                                        <option value="@(13m)">13%</option>
                                                        <option value="@(6m)">6%</option>
                                                        <option value="@(0m)">0% (Isento)</option>
                                                    </select>
                                                </td>
                                                <td class="bg-light text-end fw-bold align-middle">
                                                    @CalcularTotalLinha(linha).ToString("N2")
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoverLinha(linha)">
                                                        <i class="mdi mdi-delete"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-3">
                                <button type="button" class="btn btn-soft-primary" @onclick="AdicionarLinha">
                                    <i class="mdi mdi-plus-circle me-1"></i> Adicionar Nova Linha
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RODAPÉ: Notas e Totais -->
            <div class="row">
                <!-- Esquerda: Notas Adicionais -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-uppercase bg-light p-2 mt-0 mb-3">Informação Extra</h5>
                            <div class="mb-3">
                                <label class="form-label">Notas Adicionais (Visível para o cliente)</label>
                                <InputTextArea @bind-Value="novaFatura.Notes" class="form-control" rows="4" placeholder="Adicione termos, condições ou notas de agradecimento..." />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Direita: Resumo Financeiro -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-uppercase bg-light p-2 mt-0 mb-3">Resumo Financeiro</h5>
                            <div class="table-responsive">
                                <table class="table table-borderless mb-0">
                                    <tbody>
                                        <tr>
                                            <td>Subtotal Bruto (Antes Descontos):</td>
                                            <td class="text-end fw-bold">@SubtotalBrutoGeral.ToString("C2")</td>
                                        </tr>
                                        <tr>
                                            <td>Total Descontos Linha:</td>
                                            <td class="text-end text-danger fw-bold">- @TotalDescontos.ToString("C2")</td>
                                        </tr>
                                        <tr>
                                            <td>Base Incidência (Subtotal Líquido):</td>
                                            <td class="text-end fw-bold">@SubtotalLiquidoGeral.ToString("C2")</td>
                                        </tr>
                                        <tr>
                                            <td>Total IVA:</td>
                                            <td class="text-end fw-bold">@TotalIva.ToString("C2")</td>
                                        </tr>
                                        <tr class="bg-light border-top">
                                            <td class="fs-4 fw-bold">Total Fatura:</td>
                                            <td class="text-end fs-4 fw-bold text-primary">@TotalFinal.ToString("C2")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botões de Ação -->
            <div class="row mb-4">
                <div class="col-12 text-end">
                    <button type="button" class="btn btn-light me-2" @onclick='() => Navigation.NavigateTo("/backoffice/faturas")'>Cancelar</button>
                    <button type="button" class="btn btn-secondary me-2" @onclick="GravarComoRascunho">
                        <i class="mdi mdi-content-save-edit me-1"></i> Guardar Rascunho
                    </button>
                    <button type="button" class="btn btn-success" @onclick="AbrirModalConfirmacao">
                        <i class="mdi mdi-check-decagram me-1"></i> Emitir Fatura
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>

<!-- Modal de Confirmação de Emissão -->
@if (_mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title text-dark">Confirmação de Emissão</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body">
                    <h4 class="text-center mb-3">Atenção!</h4>
                    <p class="text-center">Está prestes a emitir definitivamente esta fatura para <strong>@(clienteSelecionado?.Name ?? "o cliente")</strong>.</p>
                    <div class="alert alert-danger mt-3 text-center" role="alert">
                        <strong>Aviso Legal:</strong> Após a emissão, o documento ficará bloqueado com assinatura digital. Não poderá ser alterado nem apagado, apenas anulado via Nota de Crédito.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="FecharModal">Cancelar</button>

                    @if (_isSaving)
                    {
                        <button type="button" class="btn btn-success" disabled>
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> A Emitir...
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success" @onclick="ConfirmarEmissao">Emitir Documento</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ====================================================================
    // ESTADO DA PÁGINA
    // ====================================================================
    [Parameter]
    public Guid? Id { get; set; }

    private bool _isLoading = true;
    private bool _loadError = false;
    private bool _isSaving = false;
    private bool _mostrarModal = false;

    private InvoiceCreateDto novaFatura = new InvoiceCreateDto();
    private EditContext _editContext;

    // Dados que virão das APIs
    private List<InvoiceProductDto> _produtosCatalogo = new();
    private EmpresaDto _empresa = new EmpresaDto();
    private List<CustomerProfileDto> _clientesAtivos = new List<CustomerProfileDto>();
    private CustomerProfileDto clienteSelecionado;

    // Totais Calculados
    private decimal SubtotalBrutoGeral = 0;
    private decimal SubtotalLiquidoGeral = 0;
    private decimal TotalDescontos = 0;
    private decimal TotalIva = 0;
    private decimal TotalFinal = 0;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _loadError = false;
        _editContext = new EditContext(novaFatura);

        try
        {
            var resultEmpresa = await CompanyService.GetCompanySettingsAsync();
            if (resultEmpresa != null) _empresa = resultEmpresa; else { _loadError = true; return; }

            var resultClientes = await CustomerService.GetCustomersActiveAsync();
            if (resultClientes != null && resultClientes.Any()) _clientesAtivos = resultClientes; else { _loadError = true; return; }

            var resultProducts = await InvoiceService.GetActiveProducts();
            if (resultProducts != null && resultProducts.Any()) _produtosCatalogo = resultProducts; else { _loadError = true; return; }

            // Lógica para carregar se for Edição
            if (Id.HasValue)
            {
                var faturaExistente = await InvoiceService.GetInvoiceByIdAsync(Id.Value);
                if (faturaExistente != null)
                {
                    novaFatura.CustomerId = faturaExistente.CustomerId;
                    novaFatura.Reference = faturaExistente.Reference;
                    novaFatura.IssueDate = faturaExistente.IssueDate;
                    novaFatura.DueDate = faturaExistente.DueDate;
                    novaFatura.Status = faturaExistente.Status;
                    novaFatura.PaymentStatus = faturaExistente.PaymentStatus;
                    novaFatura.Notes = faturaExistente.Notes;

                    novaFatura.Items = faturaExistente.Lines.Select(linha => new InvoiceLineDto
                    {
                        ProductId = linha.ProductId,
                        Quantity = (int)linha.Quantity,
                        BasePrice = linha.UnitPrice,
                        DiscountPercentage = linha.DiscountPercentage,
                        TaxRate = Math.Round(linha.TaxRate)
                    }).ToList();

                    clienteSelecionado = _clientesAtivos.FirstOrDefault(c => c.Id == novaFatura.CustomerId);
                    CalcularTotais();
                }
                else
                {
                    _loadError = true;
                }
            }
            else
            {
                novaFatura.IssueDate = DateTime.Today;
                novaFatura.DueDate = DateTime.Today;

                AdicionarLinha();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao inicializar página: {ex.Message}");
            _loadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ====================================================================
    // LÓGICA DE INTERAÇÃO (Dropdowns e Tabela)
    // ====================================================================

    private void OnClienteSelecionadoAtualizado()
    {
        // O Blazor já meteu o valor correto no novaFatura.CustomerId graças ao @bind-Value
        if (novaFatura.CustomerId.HasValue)
        {
            clienteSelecionado = _clientesAtivos.FirstOrDefault(c => c.Id == novaFatura.CustomerId.Value);

            if (clienteSelecionado != null)
            {
                int dias = clienteSelecionado.PaymentTermsDays ?? 0;
                novaFatura.DueDate = DateTime.Today.AddDays((double)dias);
            }
        }
        else
        {
            clienteSelecionado = null;
            novaFatura.DueDate = DateTime.Today;
        }
    }

    private void AdicionarLinha()
    {
        novaFatura.Items.Add(new InvoiceLineDto());
        CalcularTotais();
    }

    private void RemoverLinha(InvoiceLineDto linha)
    {
        novaFatura.Items.Remove(linha);
        CalcularTotais();
    }

    private void OnProdutoSelecionadoAtualizado(InvoiceLineDto linha)
    {
        // O Blazor já meteu o ID no linha.ProductId
        if (linha.ProductId.HasValue)
        {
            var produto = _produtosCatalogo.FirstOrDefault(p => p.Id == linha.ProductId.Value);
            if (produto != null)
            {
                linha.BasePrice = produto.BasePrice;
                linha.TaxRate = Math.Round(produto.TaxRate);
            }
        }
        else
        {
            linha.BasePrice = 0;
            linha.TaxRate = 0;
        }
        CalcularTotais();
    }

    // ====================================================================
    // LÓGICA DE CÁLCULO FINANCEIRO
    // ====================================================================

    private decimal CalcularTotalLinha(InvoiceLineDto linha)
    {
        var bruto = linha.Quantity * linha.BasePrice;
        var desconto = bruto * (linha.DiscountPercentage / 100m);
        var baseLiquida = bruto - desconto;
        var iva = baseLiquida * (linha.TaxRate / 100m);
        return baseLiquida + iva;
    }

    private void CalcularTotais()
    {
        SubtotalBrutoGeral = 0;
        TotalDescontos = 0;
        SubtotalLiquidoGeral = 0;
        TotalIva = 0;
        TotalFinal = 0;

        foreach (var linha in novaFatura.Items)
        {
            var bruto = linha.Quantity * linha.BasePrice;
            var valorDesconto = bruto * (linha.DiscountPercentage / 100m);
            var baseLiquida = bruto - valorDesconto;
            var iva = baseLiquida * (linha.TaxRate / 100m);

            SubtotalBrutoGeral += bruto;
            TotalDescontos += valorDesconto;
            SubtotalLiquidoGeral += baseLiquida;
            TotalIva += iva;
        }

        TotalFinal = SubtotalLiquidoGeral + TotalIva;
    }

    // ====================================================================
    // LÓGICA DE GRAVAÇÃO E MODAL
    // ====================================================================

    private bool ValidarFormulario()
    {
        bool formValido = _editContext.Validate();

        if (novaFatura.CustomerId == null)
        {
            Console.WriteLine("Erro: Cliente é obrigatório!");
            return false;
        }

        if (!novaFatura.Items.Any(l => l.ProductId != null))
        {
            Console.WriteLine("Erro: A fatura precisa de ter pelo menos uma linha com produto!");
            return false;
        }

        return formValido;
    }

    private async Task GravarComoRascunho()
    {
        if (!ValidarFormulario()) return;
        novaFatura.Status = InvoiceStatus.Draft;
        await GuardarFatura();
    }

    private void AbrirModalConfirmacao()
    {
        if (!ValidarFormulario()) return;
        _mostrarModal = true;
    }

    private void FecharModal() => _mostrarModal = false;

    private async Task ConfirmarEmissao()
    {
        _isSaving = true;
        novaFatura.Status = InvoiceStatus.Issued;
        await GuardarFatura();

        _isSaving = false;
        FecharModal();
    }

    private async Task GuardarFatura()
    {
        bool sucesso;

        if (Id.HasValue)
        {
            sucesso = await InvoiceService.UpdateInvoiceAsync(Id.Value, novaFatura);
        }
        else
        {
            sucesso = await InvoiceService.CreateInvoiceAsync(novaFatura);
        }

        if (sucesso)
        {
            Navigation.NavigateTo("/backoffice/faturas");
        }
        else
        {
            Console.WriteLine("Falha ao gravar fatura.");
        }
    }
}