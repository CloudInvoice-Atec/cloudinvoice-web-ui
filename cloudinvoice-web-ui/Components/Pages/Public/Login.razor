@page "/"
@using Services.Identity
@using cloudinvoice_web_ui.DTOs.Identity
@layout Layout.PublicLayout
@inject IJSRuntime JS
@* Vamos precisar do NavigationManager para redirecionar após o login *@
@inject NavigationManager NavigationManager
@inject cloudinvoice_web_ui.Services.Identity.IAuthService AuthService
@inject cloudinvoice_web_ui.Auth.TokenProvider TokenProvider
@using Microsoft.AspNetCore.Components.Authorization
@using cloudinvoice_web_ui.Auth
@inject AuthenticationStateProvider AuthStateProvider

<h4 class="mt-0">Login</h4>
<p class="text-muted mb-4">Introduza o seu email e password para aceder à sua conta.</p>

@* Alerta para mostrar mensagens de erro da API *@
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<!-- Substituímos o <form> pelo EditForm do Blazor -->
<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="emailaddress" class="form-label">Endereço de email</label>
        <!-- Trocámos o input normal por InputText e ligámos ao modelo -->
        <InputText @bind-Value="loginModel.Email" class="form-control" id="emailaddress" placeholder="Introduza o seu email" />
        <ValidationMessage For="@(() => loginModel.Email)" class="text-danger" />
    </div>

    <div class="mb-3">
        <NavLink href="/account/forgot-password" class="text-muted float-end"><small>Esqueceu a sua password?</small></NavLink>
        <label for="password" class="form-label">Password</label>
        <div class="input-group input-group-merge">
            <!-- Ligámos a password ao modelo -->
            <InputText @bind-Value="loginModel.Password" type="password" id="password" class="form-control" placeholder="Introduza a sua password" />
            <div class="input-group-text" data-password="false">
                <span class="password-eye"></span>
            </div>
        </div>
        <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
    </div>

    <div class="mb-3">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="checkbox-signin">
            <label class="form-check-label" for="checkbox-signin">Lembrar-me</label>
        </div>
    </div>

    <div class="text-center d-grid">
        <button class="btn btn-primary" type="submit" disabled="@isLoading">
            @if (isLoading)
            {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>A iniciar sessão</span>
            }
            else
            {
                <span>Iniciar Sessão</span>
            }
        </button>
    </div>

    <!-- social (mantive exatamente igual ao teu) -->
    <div class="text-center mt-4">
        <p class="text-muted font-16">Iniciar sessão com</p>
        <ul class="social-list list-inline mt-3">
            <li class="list-inline-item">
                <a href="javascript: void(0);" class="social-list-item border-primary text-primary"><i class="mdi mdi-facebook"></i></a>
            </li>
            <li class="list-inline-item">
                <a href="javascript: void(0);" class="social-list-item border-danger text-danger"><i class="mdi mdi-google"></i></a>
            </li>
            <li class="list-inline-item">
                <a href="javascript: void(0);" class="social-list-item border-info text-info"><i class="mdi mdi-twitter"></i></a>
            </li>
            <li class="list-inline-item">
                <a href="javascript: void(0);" class="social-list-item border-secondary text-secondary"><i class="mdi mdi-github"></i></a>
            </li>
        </ul>
    </div>
</EditForm>
<!-- end form-->
<!-- Footer-->
<footer class="footer footer-alt">
    <p class="text-muted">Testar as ligações às API's?  <a href="/connection-api" class="text-muted ms-1"><b>Testar aqui</b></a></p>
</footer>

@code {
    private LoginRequestDto loginModel = new LoginRequestDto();
    private bool isLoading = false;
    private string? errorMessage;

    // Captura automaticamente o ReturnUrl da QueryString enviada pelo servidor
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Tenta recuperar o token do localStorage caso o circuito tenha reiniciado
            if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
            {
                await customAuth.LoadTokenFromBrowserAsync();
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            // 2. Se o utilizador já tem uma sessão válida no browser (ex: após um F5)
            if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
            {
                RedirecionarUtilizador();
            }
            else if (!string.IsNullOrEmpty(ReturnUrl))
            {
                // Opcional mas recomendado: Limpa o ReturnUrl da barra de endereços do browser
                // substituindo a rota atual por "/" sem o parâmetro, mantendo a variável guardada em C#
                NavigationManager.NavigateTo("/", replace: true);
            }
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(loginModel);

            if (result.IsSuccess)
            {
                var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;

                // Grava o token e atualiza o estado de autenticação
                await customAuthStateProvider.MarkUserAsAuthenticated(result.Token);

                // Redireciona para o destino pretendido
                RedirecionarUtilizador();
            }
            else
            {
                errorMessage = result.Message ?? "Credenciais inválidas.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Ocorreu um erro ao contactar o servidor.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RedirecionarUtilizador()
    {
        // Se existe um ReturnUrl pendente (veio de um F5 ou acesso direto a URL protegido), devolvemos o utilizador para lá
        if (!string.IsNullOrEmpty(ReturnUrl) && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative))
        {
            NavigationManager.NavigateTo(ReturnUrl, forceLoad: false);
        }
        else
        {
            // Caso contrário, entra pela porta normal do backoffice
            NavigationManager.NavigateTo("/backoffice", forceLoad: false);
        }
    }
}