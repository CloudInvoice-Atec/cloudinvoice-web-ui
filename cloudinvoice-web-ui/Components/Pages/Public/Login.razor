@page "/"
@using Services.Identity
@using cloudinvoice_web_ui.DTOs.Identity
@layout Layout.PublicLayout
@inject IJSRuntime JS
@* Vamos precisar do NavigationManager para redirecionar após o login *@
@inject NavigationManager NavigationManager
@inject cloudinvoice_web_ui.Services.Identity.IAuthService AuthService
@inject cloudinvoice_web_ui.Auth.TokenProvider TokenProvider
@using Microsoft.AspNetCore.Components.Authorization
@using cloudinvoice_web_ui.Auth
@inject AuthenticationStateProvider AuthStateProvider

<h4 class="mt-0">Login</h4>
<p class="text-muted mb-4">Introduza o seu email e password para aceder à sua conta.</p>

@* Alerta para mostrar mensagens de erro da API *@
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<!-- Substituímos o <form> pelo EditForm do Blazor -->
<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="emailaddress" class="form-label">Endereço de email</label>
        <!-- Trocámos o input normal por InputText e ligámos ao modelo -->
        <InputText @bind-Value="loginModel.Email" class="form-control" id="emailaddress" placeholder="Introduza o seu email" />
        <ValidationMessage For="@(() => loginModel.Email)" class="text-danger" />
    </div>

    <div class="mb-3">
        <NavLink href="/account/forgot-password" class="text-muted float-end"><small>Esqueceu a sua password?</small></NavLink>
        <label for="password" class="form-label">Password</label>
        <div class="input-group input-group-merge">
            <!-- O 'type' agora muda consoante a variável booleana -->
            <InputText @bind-Value="loginModel.Password" type="@(_showPassword ? "text" : "password")" id="password" class="form-control" placeholder="Introduza a sua password" />

            <!-- Adicionado o @onclick e a mudança de estado no data-password para o CSS atuar -->
            <div class="input-group-text" style="cursor: pointer;" data-password="@(_showPassword ? "true" : "false")" @onclick="TogglePasswordVisibility">
                <span class="password-eye"></span>
            </div>
        </div>
        <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
    </div>

    <div class="text-center d-grid">
        <button class="btn btn-primary" type="submit" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>A iniciar sessão</span>
            }
            else
            {
                <span>Iniciar Sessão</span>
            }
        </button>
    </div>

    <!-- social (mantive exatamente igual ao teu) -->
    <div class="text-center mt-4">
        <p class="text-muted font-16">Iniciar sessão com</p>
        <ul class="social-list list-inline mt-3">
            <li class="list-inline-item">
                <a href="https://localhost:5001/api/auth/external-login?provider=Google" class="social-list-item border-danger text-danger">
                    <i class="mdi mdi-google"></i>
                </a>
            </li>
            <li class="list-inline-item">
                <a href="https://localhost:5001/api/auth/external-login?provider=Microsoft" class="social-list-item border-info text-info">
                    <i class="mdi mdi-microsoft"></i>
                </a>
            </li>
            <!-- Podes remover ou manter os outros se não tiverem provider configurado -->
        </ul>
    </div>
</EditForm>
<!-- end form-->
<!-- Footer-->
<footer class="footer footer-alt">
    <p class="text-muted">Testar as ligações às API's?  <a href="/connection-api" class="text-muted ms-1"><b>Testar aqui</b></a></p>
</footer>

@code {
    private LoginRequestDto loginModel = new LoginRequestDto();
    private bool isLoading = false;
    private string? errorMessage;
    private bool _showPassword = false;

    // CORREÇÃO: Captura o ReturnUrl do URL para redirecionar após o login
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? UrlError { get; set; }

    [SupplyParameterFromQuery(Name = "apiError")]
    public string? ApiError { get; set; }

    // Garante que o erro é carregado, independentemente do ciclo de vida do Blazor
    protected override void OnParametersSet()
    {
        var erro = !string.IsNullOrEmpty(UrlError) ? UrlError : ApiError;

        if (!string.IsNullOrEmpty(erro))
        {
            errorMessage = erro switch
            {
                "Token_ausente" => "Esta conta encontra-se inativa ou não tem permissões de acesso.",
                "inactive" => "Esta conta encontra-se inativa.",
                "not_registered" => "Esta conta não existe no sistema. Contacte o administrador.",
                _ => erro.Replace("_", " ")
            };
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
            {
                await customAuth.LoadTokenFromBrowserAsync();
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
            {
                RedirecionarUtilizador();
            }
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(loginModel);

            if (result.IsSuccess)
            {
                var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;
                await customAuthStateProvider.MarkUserAsAuthenticated(result.Token);
                RedirecionarUtilizador();
            }
            else
            {
                errorMessage = result.Message ?? "Credenciais inválidas.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Ocorreu um erro ao contactar o servidor.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RedirecionarUtilizador()
    {
        // Usa o ReturnUrl para voltar ao destino original
        if (!string.IsNullOrEmpty(ReturnUrl) && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative))
        {
            NavigationManager.NavigateTo(ReturnUrl, forceLoad: false);
        }
        else
        {
            NavigationManager.NavigateTo("/backoffice", forceLoad: false);
        }
    }
}