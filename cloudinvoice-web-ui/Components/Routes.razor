@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(cloudinvoice_web_ui.Components.Layout.PublicLayout)">
            <NotAuthorized>

                @* Design minimalista feito à medida para a coluna esquerda do PublicLayout *@
                <div class="text-center w-100 mt-4">
                    <div class="mb-4">
                        <i class="mdi mdi-shield-lock-outline text-danger" style="font-size: 4.5rem;"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-3">Acesso Negado</h3>
                    <p class="text-muted mb-4 fs-6">
                        Desculpa, mas não tens permissões para aceder a esta página ou funcionalidade.
                    </p>
                    <div class="d-grid mt-4">
                        <a href="/backoffice" class="btn btn-primary btn-lg rounded-3 shadow-sm">
                            Voltar ao Início
                        </a>
                    </div>
                </div>

            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>

    <NotFound>
        <LayoutView Layout="typeof(cloudinvoice_web_ui.Components.Layout.PublicLayout)">
            <div class="text-center w-100 mt-4">
                <h3 class="fw-bold text-dark mb-3">Página não encontrada</h3>
                <p class="text-muted mb-4 fs-6">
                    Lamento, mas esta página não existe no CloudInvoice.
                </p>
                <div class="d-grid mt-4">
                    <a href="/" class="btn btn-primary btn-lg rounded-3 shadow-sm">
                        Ir para o Login
                    </a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
﻿@using cloudinvoice_web_ui.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

@if (_isCheckingAuth)
{
    <!-- Mostra um loading enquanto o JSInterop não está pronto para ler o token -->
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">A verificar sessão...</p>
        </div>
    </div>
}
else
{
    <CascadingAuthenticationState>
        <Router AppAssembly="typeof(Program).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(cloudinvoice_web_ui.Components.Layout.PublicLayout)">
                    <NotAuthorized>
                        @{
                            // Se após verificarmos o token, o utilizador continuar anónimo, redireciona
                            Navigation.NavigateTo("/login", forceLoad: true);
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(cloudinvoice_web_ui.Components.Layout.PublicLayout)">
                    <p role="alert">Lamento, mas esta página não existe no Invoice Cloud.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
}

@code {
    // Variável de estado crucial em C# para bloquear o Router
    private bool _isCheckingAuth = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Agora o JS Interop é 100% seguro de executar
            if (AuthProvider is CustomAuthenticationStateProvider customAuth)
            {
                await customAuth.LoadTokenFromBrowserAsync();
            }

            // 2. Liberta o bloqueio e permite que o Router faça o seu trabalho
            _isCheckingAuth = false;

            // 3. Força a UI a redesenhar para esconder o spinner e mostrar a aplicação
            StateHasChanged();
        }
    }
}
