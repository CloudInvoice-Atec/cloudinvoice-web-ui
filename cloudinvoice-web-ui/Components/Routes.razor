@using cloudinvoice_web_ui.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

@if (_isCheckingAuth)
{
    <!-- Mostra um loading enquanto o JSInterop valida o token no browser -->
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">A verificar sessão...</p>
        </div>
    </div>
}
else
{
    <CascadingAuthenticationState>
        <Router AppAssembly="typeof(Program).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(cloudinvoice_web_ui.Components.Layout.PublicLayout)">
                    <NotAuthorized>
                        @{
                            // Se o utilizador não estiver autorizado, redireciona para o login
                            Navigation.NavigateTo("/login", forceLoad: true);
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(cloudinvoice_web_ui.Components.Layout.PublicLayout)">
                    <div class="text-center w-100 mt-4">
                        <h3 class="fw-bold text-dark mb-3">Página não encontrada</h3>
                        <p class="text-muted mb-4 fs-6">
                            Lamento, mas esta página não existe no CloudInvoice.
                        </p>
                        <div class="d-grid mt-4">
                            <a href="/" class="btn btn-primary btn-lg rounded-3 shadow-sm">
                                Ir para o Início
                            </a>
                        </div>
                    </div>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
}

@code {
    private bool _isCheckingAuth = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Valida o token no localStorage de forma segura
            if (AuthProvider is CustomAuthenticationStateProvider customAuth)
            {
                await customAuth.LoadTokenFromBrowserAsync();
            }

            // 2. Liberta o ecrã
            _isCheckingAuth = false;

            // 3. Atualiza a interface para desenhar o Router correto
            StateHasChanged();
        }
    }
}