@using cloudinvoice_web_ui.DTOs.Identity

@if (IsVisible && User != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Eliminação</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="OnCancel"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-3">
                        <i class="mdi mdi-alert-circle-outline text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="text-center mb-4">Tem a certeza que deseja eliminar este utilizador?</h4>

                    <div class="bg-light p-3 rounded">
                        <p class="mb-1"><strong>Nome:</strong> @User.FirstName @User.LastName</p>
                        <p class="mb-1"><strong>Email:</strong> @User.Email</p>
                        <p class="mb-0">
                            <strong>Perfil:</strong>
                            <span class="badge @(User.Role == "Admin" ? "bg-danger" : "bg-success")">
                                @User.Role
                            </span>
                        </p>
                    </div>

                    <p class="text-center text-muted mt-3 mb-0"><small>Atenção: Esta ação não pode ser desfeita.</small></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="OnCancel">Cancelar</button>
                    <!-- Quando clica, dispara o evento para a página principal -->
                    <button type="button" class="btn btn-danger" @onclick="() => OnConfirm.InvokeAsync(User)">Sim, Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // 1. Recebe a ordem para aparecer ou desaparecer
    [Parameter]
    public bool IsVisible { get; set; }

    // 2. Recebe os dados do utilizador a mostrar
    [Parameter]
    public UserResponseDto? User { get; set; }

    // 3. Evento para avisar o pai que é para fechar (botão Cancelar/Cruz)
    [Parameter]
    public EventCallback OnCancel { get; set; }

    // 4. Evento para avisar o pai que o utilizador confirmou a eliminação
    [Parameter]
    public EventCallback<UserResponseDto> OnConfirm { get; set; }
}